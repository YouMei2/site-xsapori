# =====================================================================
#  X-Sapori Savona — защита служебных файлов
#  Apache 2.4 (шаред-хостинг). Если хостинг на nginx — см. README.md.
# =====================================================================

# ---------------------------------------------------------------------
#  Файлы, которые не должны отдаваться по HTTP никогда
# ---------------------------------------------------------------------
# Пароли внутри они не содержат, но выдают структуру базы, имя
# пользователя БД и внутреннее устройство — это готовая разведка
# для атакующего. Проверено: без этого правила схема скачивается
# по прямой ссылке /schema.sql.
<FilesMatch "(?i)\.(sql|md|log|bak|old|orig|save|swp|dist|example)$">
  Require all denied
</FilesMatch>

# Конфиг на хостинге лежит выше корня сайта, но если его случайно
# положат рядом — пусть лучше отдаст 403, чем содержимое.
<FilesMatch "(?i)^config.*\.php$">
  Require all denied
</FilesMatch>

# Точечные файлы: .gitignore, .env, .htpasswd и прочее.
<FilesMatch "(?i)^\.">
  Require all denied
</FilesMatch>

# notify.php — библиотека, а не endpoint. Подключается из booking.php.
# Прямой вызов ничего не делает и ничего не выводит, но открытым
# держать незачем.
<Files "notify.php">
  Require all denied
</Files>

# ---------------------------------------------------------------------
#  Заголовки безопасности
# ---------------------------------------------------------------------
<IfModule mod_headers.c>
  # Браузер не должен угадывать тип содержимого.
  Header always set X-Content-Type-Options "nosniff"
  # Сайт не предназначен для вставки в iframe на чужих доменах.
  Header always set X-Frame-Options "SAMEORIGIN"
  # Referer при переходе на внешние ссылки не раскрывает полный путь.
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Формы и API нельзя кешировать промежуточным прокси.
  <FilesMatch "\.php$">
    Header always set Cache-Control "no-store"
  </FilesMatch>
</IfModule>

# ---------------------------------------------------------------------
#  Ошибки PHP не должны попадать в браузер
# ---------------------------------------------------------------------
# booking.php выставляет это сам через ini_set, но если хостинг
# запускает PHP так, что ini_set не срабатывает, — вот подстраховка.
<IfModule mod_php.c>
  php_flag display_errors off
  php_flag log_errors on
</IfModule>

# ---------------------------------------------------------------------
#  Индексы каталогов
# ---------------------------------------------------------------------
# Без этого /uploads/ показывал бы список всех файлов.
Options -Indexes

DirectoryIndex index.html index.php
