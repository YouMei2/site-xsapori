# =====================================================================
#  Секреты — НИКОГДА не коммитить
# =====================================================================
# Доступы к БД, соль для хеширования IP, токен Telegram-бота.
# В репозитории живёт только config.example.php без реальных значений.
config.php
/config.php
**/config.php
!config.example.php

# Прочие возможные носители секретов
.env
.env.*
*.pem
*.key

# =====================================================================
#  Логи и дампы
# =====================================================================
*.log
error_log
php_errorlog
*.sql.gz
dump*.sql
backup*.sql

# =====================================================================
#  Служебное
# =====================================================================
.DS_Store

# Anteprime e report di lavorazione: restano sul disco, fuori dal repo
# e fuori dall'FTP. Bloccati anche da .htaccess, per sicurezza doppia.
anteprima-*.html
audit-*.html
.thumbnail

# Immagini in attesa di lavorazione: PNG grezzi da 11 MB. Nel repo ci
# vanno solo le versioni finite e convertite, dentro uploads/.
uploads/da-integrare/
