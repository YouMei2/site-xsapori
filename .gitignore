# File locali di sviluppo, mai da pubblicare
_audit.js

# `.dev-server.js` NON è più qui, dal 25 agosto 2026. Era ignorato come
# «file locale», ma nel frattempo è diventato l'unico modo per provare il
# sito: serve i file statici e inoltra `/api/` e `/admin/` ad Apache, così
# le prenotazioni funzionano senza cambiare porta. Ignorandolo, chi clona il
# progetto non ha nessuna anteprima e deve riscriverselo.
#
# Non contiene credenziali, e «mai da pubblicare» resta vero per altra via:
# `.htaccess` nega ogni file che comincia per punto, quindi anche se finisce
# sull'FTP non è raggiungibile.

# Configurazione con le credenziali reali
config.php

# Sistema
Thumbs.db
.DS_Store

# Anteprime e report di lavorazione: restano sul disco, fuori dal repo
# e fuori dall'FTP. Bloccati anche da .htaccess, per sicurezza doppia.
anteprima-*.html
audit-*.html
.thumbnail

# Immagini in attesa di lavorazione: PNG grezzi da 11 MB. Nel repo ci
# vanno solo le versioni finite e convertite, dentro uploads/.
uploads/da-integrare/

# Configurazione locale dell'anteprima (porta 4173): come .dev-server.js,
# serve solo su questo computer.
.claude/
